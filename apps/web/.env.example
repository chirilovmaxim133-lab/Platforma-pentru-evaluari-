# Adresa publică a platformei (folosită în codurile QR și în MPass).
# Pentru test pe telefon în aceeași rețea Wi-Fi: adresa calculatorului, ex. http://192.168.1.20:3000
# Pe HTTPS (platforma publicată) se activează automat cookie-urile „Secure” și antetele stricte.
APP_URL=http://localhost:3000

# Baza de date PostgreSQL
DATABASE_URL=postgres://postgres@localhost:5432/evaluari

# Unde se salvează imaginile încărcate de profesori (în producție: stocare S3)
UPLOAD_DIR=./storage/uploads

# Secret pentru semnarea datelor temporare și anonimizarea identificatorilor MPass (șir lung, aleator)
AUTH_SECRET=schimba-acest-secret

# --- Analiză AI a răspunsurilor lungi (opțional) ---
# Fără cheie, platforma folosește doar semnalele proprii (lipire text, viteză, capcană AI, similaritate).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- MPass (SAML 2.0) — se completează după acordul cu AGE ---
# Valorile exacte (adrese de login/logout, certificatul MPass) se iau din documentația
# oficială MPass pentru furnizorii de servicii (mediul de testare: mpass.staging.egov.md).
MPASS_ENABLED=false
MPASS_ENTRY_POINT=
MPASS_LOGOUT_URL=
MPASS_ISSUER=
MPASS_IDP_CERT=
MPASS_SP_PRIVATE_KEY=
MPASS_SP_CERT=
